# ==============================================================================
# CARD NGO — Environment Variables
# Copy this file to .env for local development.
# In Vercel, add these under: Project Settings -> Environment Variables
# ==============================================================================

# Gmail SMTP Configuration (for Contact form & Newsletter alerts)
# 1. Go to your Google Account (cardngo.org@gmail.com) -> Security
# 2. Enable 2-Step Verification
# 3. Search for "App Passwords" and create a password for "Mail" / "CARD Website"
# 4. Paste the 16-character generated password below as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cardngo.org@gmail.com
SMTP_PASS=your-16-character-gmail-app-password

# Admin destination email where inquiries & new subscriber notices are received
ADMIN_EMAIL=cardngo.org@gmail.com

# Optional: Gemini API Key (if enabling AI features)
GEMINI_API_KEY=
